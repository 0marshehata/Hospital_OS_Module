<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Hospital Management OS access category -->
    <record id="hospital_managment_access" model="ir.module.category">
        <field name="name">Hospital Management OS</field>
        <field name="description">User access levels for Hospital Management OS</field>
        <field name="sequence">10</field>
    </record>

    <!-- Lab Assistant access group -->
    <record id="hospital_managment_group_lab_assistant" model="res.groups">
        <field name="name">Lab Assistant</field>
        <field name="category_id" ref="hospital_managment_access"/>
    </record>

    <!-- Pharmacist access group -->
    <record id="hospital_managment_group_pharmacist" model="res.groups">
        <field name="name">Pharmacist</field>
        <field name="category_id" ref="hospital_managment_access"/>
    </record>

    <!-- Nurse access group -->
    <record id="hospital_managment_group_nurse" model="res.groups">
        <field name="name">Nurse</field>
        <field name="category_id" ref="hospital_managment_access"/>
    </record>

    <!-- Doctor access group -->
    <record id="hospital_managment_group_doctor" model="res.groups">
        <field name="name">Doctor</field>
        <field name="category_id" ref="hospital_managment_access"/>
    </record>

    <!-- Receptionist access group -->
    <record id="hospital_managment_group_receptionist" model="res.groups">
        <field name="name">Receptionist</field>
        <field name="category_id" ref="hospital_managment_access"/>
    </record>

    <!-- Manager access group -->
    <record id="hospital_managment_group_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="category_id" ref="hospital_managment_access"/>
    </record>
</odoo>
